---
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}: Blog</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ '/blog/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/blog/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/blog/' | absolute_url }}</id>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author><name>{{ site.title | xml_escape }}</name></author>
  {%- capture src_abs %}src="{{ site.url }}/{% endcapture %}
  {%- capture href_abs %}href="{{ site.url }}/{% endcapture %}
  {%- for post in site.posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {%- endfor %}
    <summary>{{ post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 280 | xml_escape }}</summary>
    <content type="html">{{ post.content | replace: 'src="/', src_abs | replace: 'href="/', href_abs | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
